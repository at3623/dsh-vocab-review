{
  "name": "dsh-vocab-review",
  "version": "1.3.1",
  "description": "Underlined-word vocabulary review for DeepSeek Harness: image ingestion, one-word-at-a-time quiz loop that keeps going while words are due, persistent wrong-word ledger, spaced repetition, conversation routing, strong-pause stop, daily quota, due reminders, and an optional QQ chat channel through dsh-qq-bot.",
  "type": "module",
  "license": "MIT",
  "author": "At",
  "repository": {
    "type": "git",
    "url": "https://github.com/at3623/dsh-vocab-review.git"
  },
  "homepage": "https://github.com/at3623/dsh-vocab-review#readme",
  "bugs": {
    "url": "https://github.com/at3623/dsh-vocab-review/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "vocabulary",
    "spaced-repetition",
    "quiz",
    "qq",
    "qq-bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node test/harness.mjs && node test/sessions-stop.mjs && node test/client-load-check.mjs",
    "check": "node --check index.js && node --check client.js"
  }
}
